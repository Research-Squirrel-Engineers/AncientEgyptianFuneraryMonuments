<https://w3id.org/aefm/vocab/spaceFunction/side_room> a skos:Concept ;
    skos:inScheme aefm-v:spaceFunction ;
    skos:notation "SR" ;
    skos:prefLabel "side room"@en ;
    skos:topConceptOf aefm-v:spaceFunction ;
    aefm-v:angleMax 105.0 ;
    aefm-v:angleMin 72.0 ;
    aefm-v:angleSymbol "alpha" ;
    aefm-v:lengthMax 27.0 ;
