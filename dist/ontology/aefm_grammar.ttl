<https://w3id.org/aefm/vocab/spaceFunction/sanctuary_hall> a skos:Concept ;
    skos:inScheme aefm-v:spaceFunction ;
    skos:notation "SYH" ;
    skos:prefLabel "sanctuary hall"@en ;
