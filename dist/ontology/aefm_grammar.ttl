    aefm-v:widthMax 11.0 ;
    aefm-v:widthMin 2.5 .

<https://w3id.org/aefm/vocab/spaceFunction/staircase> a skos:Concept ;
    skos:inScheme aefm-v:spaceFunction ;
    skos:notation "SC" ;
    skos:note "upper length bound is open in the source: [12 c; 20 c)"@en ;
    skos:prefLabel "staircase"@en ;
    skos:topConceptOf aefm-v:spaceFunction ;
    aefm-v:angleMax 90.0 ;
    aefm-v:angleMin 82.0 ;
