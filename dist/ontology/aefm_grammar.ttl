<https://w3id.org/aefm/vocab/spaceFunction/ramp> a skos:Concept ;
    skos:inScheme aefm-v:spaceFunction ;
    skos:notation "RP" ;
    skos:note "length is printed as \"[67 c)\" in the source and cannot be read as a range"@en ;
    skos:prefLabel "ramp"@en ;
    skos:topConceptOf aefm-v:spaceFunction ;
    aefm-v:measuredIn <https://w3id.org/aefm/unit/cubit> ;
    aefm-v:widthMax 7.0 ;
    aefm-v:widthMin 5.0 .

<https://w3id.org/aefm/vocab/spaceFunction/sanctuary> a skos:Concept ;
    skos:inScheme aefm-v:spaceFunction ;
    skos:notation "SY" ;
    skos:prefLabel "sanctuary"@en ;
